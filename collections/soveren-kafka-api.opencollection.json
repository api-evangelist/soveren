          "info": {
            "name": "Get a Kafka topic",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.soveren.io/api/v1/kafka/topics/:id",
            "params": [
              {
                "name": "id",
                "value": "",
