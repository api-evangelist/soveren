{
  "opencollection": "1.0.0",
  "info": {
    "name": "Soveren Object Assets Endpoints API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Endpoints",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List endpoints for an asset",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.soveren.io/api/v1/assets/:id/endpoints",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of items to return."
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Number of items to skip for pagination."
              }
            ]
          },
          "docs": "List endpoints for an asset"
        },
        {
          "info": {
            "name": "Get an endpoint",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.soveren.io/api/v1/endpoints/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Returns a single endpoint (a hostname / method / URL combination discovered on an asset)."
        }
      ]
    }
  ],
  "bundled": true
}